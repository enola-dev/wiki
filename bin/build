#!/usr/bin/env bash
set -eu -o pipefail

if [ -d ../wiki-ui ]; then
  (cd ../wiki-ui && direnv exec . bun run build)
  mkdir -p ../enola/java/dev/enola/common/markdown/resources/web
  rm -rf ../enola/java/dev/enola/common/markdown/resources/web/*
  cp -r ../wiki-ui/dist/* ../enola/java/dev/enola/common/markdown/resources/web/
fi

enola() {
  direnv exec ../enola ../enola/enola "$@"
}

enola markdown format docs/

rm -rf out
mkdir -p out/markdown out/html

enola markdown generate-md docs/ out/markdown/
enola markdown generate-html docs/ out/html/ https://github.com/enola-dev/wiki/edit/main/docs/
